    "gitDecoration.modifiedResourceForeground": "#7da3cc",
    "gitDecoration.deletedResourceForeground": "#e5847f",
    "gitDecoration.untrackedResourceForeground": "#7ecdb3",
    "gitDecoration.ignoredResourceForeground": "#83688f",
    "gitDecoration.conflictingResourceForeground": "#d9a95b",

    "terminal.background": "#0f0912",
    "terminal.foreground": "#f2e7f7",
    "terminalCursor.foreground": "#f480c1",
    "terminal.selectionBackground": "#e0559f55",
    "terminal.inactiveSelectionBackground": "#e0559f33",
    "terminal.findMatchBackground": "#702d55",
    "terminal.findMatchBorder": "#f480c1",
    "terminal.findMatchHighlightBackground": "#702d5588",
    "terminal.hoverHighlightBackground": "#e0559f22",
    "terminal.border": "#150d18",
    "terminal.dropBackground": "#e0559f33",
    "terminal.tab.activeBorder": "#f480c1",
    "terminalCursor.background": "#0f0912",
    "terminalCommandDecoration.defaultBackground": "#83688f",
    "terminalCommandDecoration.successBackground": "#74c496",
    "terminalCommandDecoration.errorBackground": "#e5847f",
