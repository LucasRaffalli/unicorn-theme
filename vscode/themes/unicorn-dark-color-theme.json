    "statusBarItem.hoverBackground": "#281a30",
    "statusBarItem.remoteBackground": "#e0559f",
    "statusBarItem.remoteForeground": "#ffffff",

    "panel.background": "#0f0912",
    "panel.border": "#150d18",
