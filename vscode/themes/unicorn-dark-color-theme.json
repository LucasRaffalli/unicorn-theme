    "terminal.ansiBrightCyan": "#9adbc7",
    "terminal.ansiBrightWhite": "#f2e7f7"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#83688f", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#f480c1" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#74c496" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#ff9fd6", "fontStyle": "bold" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#bd93f9" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "#7da3cc" } },
    { "scope": ["entity.name.class", "entity.name.type", "entity.other.inherited-class", "support.class", "support.type"], "settings": { "foreground": "#7ecdb3" } },
    { "scope": ["variable.parameter", "meta.decorator", "entity.name.function.decorator", "storage.type.annotation"], "settings": { "foreground": "#e39b8f" } },
    { "scope": ["variable", "variable.other", "meta.definition.variable"], "settings": { "foreground": "#f2e7f7" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#dcc8e8" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace"], "settings": { "foreground": "#bb9cca" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#f480c1" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e39b8f", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"], "settings": { "foreground": "#7ecdb3" } },
    { "scope": ["support.type.property-name.css", "support.type.property-name.json"], "settings": { "foreground": "#7da3cc" } },
    { "scope": ["constant.other.color", "keyword.other.unit"], "settings": { "foreground": "#bd93f9" } },
    { "scope": ["entity.name.section.markdown", "markup.heading"], "settings": { "foreground": "#f480c1", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#74c496" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#f480c1" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#74c496" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#e5847f" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#e5847f" } },
    { "scope": ["keyword.other.documentation", "storage.type.class.jsdoc", "entity.name.type.instance.jsdoc"], "settings": { "foreground": "#a384b3", "fontStyle": "italic" } }
  ]
}
