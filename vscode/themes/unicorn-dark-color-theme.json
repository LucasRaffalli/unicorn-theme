    "terminal.ansiGreen": "#74c496",
    "terminal.ansiYellow": "#d9a95b",
    "terminal.ansiBlue": "#7da3cc",
    "terminal.ansiMagenta": "#f480c1",
    "terminal.ansiCyan": "#7ecdb3",
    "terminal.ansiWhite": "#dcc8e8",
