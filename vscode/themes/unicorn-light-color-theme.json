    "statusBarItem.hoverBackground": "#d6d9de",
    "statusBarItem.remoteBackground": "#e0559f",
    "statusBarItem.remoteForeground": "#ffffff",
    "panel.background": "#ffffff",
    "panel.border": "#d6d9de",
    "panelTitle.activeForeground": "#15141b",
    "panelTitle.activeBorder": "#b83a7e",
    "panelTitle.inactiveForeground": "#6b7280",
    "badge.background": "#e0559f",
    "badge.foreground": "#ffffff",
    "button.background": "#e0559f",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#a02f6d",
    "button.secondaryBackground": "#e5e7eb",
    "button.secondaryForeground": "#15141b",
    "button.secondaryHoverBackground": "#d6d9de",
    "input.background": "#ffffff",
    "input.border": "#e5e7eb",
    "input.foreground": "#15141b",
    "input.placeholderForeground": "#6b7280",
    "inputOption.activeBorder": "#b83a7e",
    "inputOption.activeBackground": "#b83a7e33",
    "inputValidation.errorBorder": "#c4524b",
    "inputValidation.warningBorder": "#a8741a",
    "inputValidation.infoBorder": "#4a7aa8",
    "dropdown.background": "#ffffff",
    "dropdown.border": "#e5e7eb",
    "checkbox.background": "#ffffff",
    "checkbox.border": "#d6d9de",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#6b728044",
    "scrollbarSlider.hoverBackground": "#6b728077",
    "scrollbarSlider.activeBackground": "#e0559f88",
    "progressBar.background": "#b83a7e",
    "textLink.foreground": "#b83a7e",
    "textLink.activeForeground": "#a02f6d",
    "textCodeBlock.background": "#f3f4f6",
    "textBlockQuote.background": "#f3f4f6",
    "textBlockQuote.border": "#e0559f",
    "textSeparator.foreground": "#e5e7eb",
    "notifications.background": "#ffffff",
    "notifications.border": "#d6d9de",
    "notificationCenterHeader.background": "#eceef1",
    "extensionButton.prominentBackground": "#e0559f",
    "extensionButton.prominentHoverBackground": "#a02f6d",
