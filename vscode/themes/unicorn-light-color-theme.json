    "gitDecoration.modifiedResourceForeground": "#4a7aa8",
    "gitDecoration.deletedResourceForeground": "#c4524b",
    "gitDecoration.untrackedResourceForeground": "#2f8f78",
    "gitDecoration.ignoredResourceForeground": "#6b7280",
    "gitDecoration.conflictingResourceForeground": "#a8741a",
    "terminal.background": "#ffffff",
    "terminal.foreground": "#15141b",
    "terminalCursor.foreground": "#b83a7e",
    "terminal.selectionBackground": "#f7d4e7",
    "terminal.ansiBlack": "#15141b",
    "terminal.ansiRed": "#b5443d",
    "terminal.ansiGreen": "#23764a",
    "terminal.ansiYellow": "#8a5d0a",
    "terminal.ansiBlue": "#3d6a96",
    "terminal.ansiMagenta": "#b83a7e",
    "terminal.ansiCyan": "#1f7a65",
    "terminal.ansiWhite": "#7b8390",
    "terminal.ansiBrightBlack": "#5b6470",
    "terminal.ansiBrightRed": "#cc5a53",
    "terminal.ansiBrightGreen": "#2f8f5b",
    "terminal.ansiBrightYellow": "#a8741a",
    "terminal.ansiBrightBlue": "#4a7aa8",
    "terminal.ansiBrightMagenta": "#c8448c",
    "terminal.ansiBrightCyan": "#2f8f78",
    "terminal.ansiBrightWhite": "#9aa1ab",
    "menu.selectionForeground": "#15141b",
    "terminal.inactiveSelectionBackground": "#f7d4e788",
    "terminal.findMatchBackground": "#f0b3d4",
    "terminal.findMatchBorder": "#b83a7e",
    "terminal.findMatchHighlightBackground": "#f7d4e7aa",
    "terminal.hoverHighlightBackground": "#e0559f22",
    "terminal.border": "#d6d9de",
    "terminal.dropBackground": "#e0559f33",
    "terminal.tab.activeBorder": "#b83a7e",
    "terminalCursor.background": "#ffffff",
    "terminalCommandDecoration.defaultBackground": "#9aa1ab",
    "terminalCommandDecoration.successBackground": "#2f8f5b",
    "terminalCommandDecoration.errorBackground": "#c4524b",
    "terminalOverviewRuler.cursorForeground": "#b83a7e",
    "terminalOverviewRuler.findMatchForeground": "#b83a7e"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6b7280",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#b83a7e"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#2f8f5b"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#cf4a95",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8458ee"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#4a7aa8"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#2f8f78"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#c0604f"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#15141b"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#1b1a21"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#4b5563"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#b83a7e"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#c0604f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#2f8f78"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#4a7aa8"
      }
    },
    {
      "scope": [
        "constant.other.color",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#8458ee"
      }
    },
    {
      "scope": [
        "entity.name.section.markdown",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#b83a7e",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#2f8f5b"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#b83a7e"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#2f8f5b"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#c4524b"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c4524b"
      }
    },
    {
      "scope": [
        "keyword.other.documentation",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#6b7280",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag.css",
        "support.constant.property-value"
      ],
      "settings": {
        "foreground": "#2f8f78"
      }
    }
  ]
}
